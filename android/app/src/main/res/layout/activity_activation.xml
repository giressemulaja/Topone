<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gm_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:maxWidth="420dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo GM Corporate"
                android:src="@drawable/gm_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="GM CORPORATE"
                android:textColor="@color/gm_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/app_title"
                android:textColor="@color/gm_fg"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:text="Première ouverture sur ce téléphone.\nEntrez le code d'activation fourni par GM Corporate."
                android:textColor="@color/gm_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.06"
                android:text="CODE D'ACTIVATION"
                android:textColor="@color/gm_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/gm_fg"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/show"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Afficher le code"
                android:textColor="@color/gm_muted" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="20dp"
                android:textColor="@color/gm_bad"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/activate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_bg"
                android:stateListAnimator="@null"
                android:text="Activer l'application"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="© 2026 GM Corporate · Tous droits réservés\nDéveloppeur : Giresse Mulaja · Tél. +243 810 000 421\ngiressemulaja8@gmail.com"
            android:textColor="@color/gm_muted"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
